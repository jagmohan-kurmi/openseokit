{
  "name": "@jagmohan-kurmi/openseokit",
  "version": "0.1.0",
  "description": "Technical SEO auditing library and CLI for metadata, structure, sitemap, robots, canonical and accessibility checks.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "openseokit": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "dev": "tsx src/cli.ts"
  },
  "keywords": [
    "seo",
    "technical-seo",
    "audit",
    "accessibility",
    "cheerio"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "dependencies": {
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
